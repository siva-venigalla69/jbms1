-- ============================================================================
-- KEEP: Core Business Tables (11 tables)
-- ============================================================================

-- These tables are KEPT and used in simplified system:
-- 1. customers
-- 2. orders
-- 3. material_in
-- 4. material_stock (recreated in step 2)
-- 5. delivery_challans
-- 6. challan_items
-- 7. gst_invoices
-- 8. payments
-- 9. returns (new - created in step 2)
-- 10. credit_notes (new - created in step 2)
-- 11. misprint_sales (new - created in step 2)

-- ALSO KEEP:
-- - user_profiles (for authentication)
-- - user_activity_log (optional - for audit)
-- - system_settings (optional - for configuration)

-- ============================================================================
-- VERIFICATION
-- ============================================================================

DO $$
DECLARE
  public_count INTEGER;
  backup_count INTEGER;
BEGIN
  -- Count tables in public schema
  SELECT COUNT(*) INTO public_count
  FROM information_schema.tables
  WHERE table_schema = 'public';

  -- Count tables in backup schema
  SELECT COUNT(*) INTO backup_count
  FROM information_schema.tables
  WHERE table_schema = 'backup_schema';

  RAISE NOTICE '';
  RAISE NOTICE '========================================================================';
  RAISE NOTICE '✅ CLEANUP COMPLETE!';
  RAISE NOTICE '========================================================================';
  RAISE NOTICE '';
  RAISE NOTICE '📊 FINAL SUMMARY:';
  RAISE NOTICE '   • Tables in public schema: %', public_count;
  RAISE NOTICE '   • Tables in backup_schema: %', backup_count;
  RAISE NOTICE '   • Simplified system ready!';
  RAISE NOTICE '';
  RAISE NOTICE '⚠️  IMPORTANT:';
  RAISE NOTICE '   • All dropped tables are backed up in backup_schema';
  RAISE NOTICE '   • To restore: COPY from backup_schema to public';
  RAISE NOTICE '   • Keep backup_schema until new system is verified';
  RAISE NOTICE '';
  RAISE NOTICE '========================================================================';
  RAISE NOTICE '';
END $$;

-- List remaining tables in public schema
SELECT
  table_name,
  (SELECT COUNT(*) FROM information_schema.columns
   WHERE table_schema = 'public' AND table_name = t.table_name) AS column_count
FROM information_schema.tables t
WHERE table_schema = 'public'
ORDER BY table_name;
