-- returns table
CREATE TABLE IF NOT EXISTS returns (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  customer_id UUID REFERENCES customers(id),
  order_id UUID REFERENCES orders(id),
  return_type VARCHAR(50) NOT NULL CHECK (return_type IN ('customer_return', 'damaged_return')),
  material_type VARCHAR(50) NOT NULL,
  quantity INTEGER NOT NULL CHECK (quantity > 0),
  reason TEXT,
  return_date DATE DEFAULT CURRENT_DATE,
  adjustment_amount DECIMAL(10,2),
  status VARCHAR(50) DEFAULT 'pending' CHECK (status IN ('pending', 'processed', 'credited')),
  created_at TIMESTAMP DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_returns_customer ON returns(customer_id);
CREATE INDEX IF NOT EXISTS idx_returns_order ON returns(order_id);

DO $$
BEGIN
  RAISE NOTICE '[6/13] Created: returns';
END $$;

-- credit_notes table
CREATE TABLE IF NOT EXISTS credit_notes (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  credit_note_number VARCHAR(50) UNIQUE NOT NULL DEFAULT generate_credit_note_number(),
  customer_id UUID NOT NULL REFERENCES customers(id),
  invoice_id UUID REFERENCES gst_invoices(id),
  order_id UUID REFERENCES orders(id),
  credit_amount DECIMAL(10,2) NOT NULL CHECK (credit_amount > 0),
  reason TEXT NOT NULL,
  status VARCHAR(50) DEFAULT 'pending' CHECK (status IN ('pending', 'applied', 'cancelled')),
  applied_to_invoice_id UUID REFERENCES gst_invoices(id),
  applied_date DATE,
  notes TEXT,
  created_at TIMESTAMP DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_credit_notes_customer ON credit_notes(customer_id);

DO $$
BEGIN
  RAISE NOTICE '[7/13] Created: credit_notes';
END $$;

-- misprint_sales table
CREATE TABLE IF NOT EXISTS misprint_sales (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  sale_number VARCHAR(50) UNIQUE NOT NULL DEFAULT generate_misprint_sale_number(),
  sale_date DATE DEFAULT CURRENT_DATE,
  material_type VARCHAR(50) NOT NULL,
  quantity INTEGER NOT NULL CHECK (quantity > 0),
  unit_price DECIMAL(10,2) NOT NULL,
  total_amount DECIMAL(10,2) NOT NULL,
  customer_name VARCHAR(255),
  phone VARCHAR(20),
  payment_method VARCHAR(50),
  notes TEXT,
  created_at TIMESTAMP DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_misprint_sales_date ON misprint_sales(sale_date DESC);

DO $$
BEGIN
  RAISE NOTICE '[8/13] Created: misprint_sales';
END $$;

