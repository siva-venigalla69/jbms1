-- ============================================================================
-- PART 1: REFERENCE TABLE - MATERIAL TYPES (Product Types)
-- ============================================================================

CREATE TABLE IF NOT EXISTS material_types (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  type_code VARCHAR(20) UNIQUE NOT NULL,
  type_name VARCHAR(100) NOT NULL,
  description TEXT,
  unit_of_measure VARCHAR(20) DEFAULT 'pieces',
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT NOW()
);

-- Insert product types
INSERT INTO material_types (type_code, type_name, description) VALUES
  ('SAREE', 'Sarees', 'Traditional sarees'),
  ('DUPATTA', 'Dupattas', 'Dupattas/Chunnis'),
  ('VONI', 'Voni', 'Voni/Pallu'),
  ('LEHENGA', 'Lehenga', 'Lehenga sets'),
  ('RUNNING', 'Running Material', 'Running fabric by meter')
ON CONFLICT (type_code) DO NOTHING;

CREATE INDEX IF NOT EXISTS idx_material_types_code ON material_types(type_code);

DO $$
BEGIN
  RAISE NOTICE '[1/13] Created: material_types (Product Types)';
END $$;

-- ============================================================================
-- PART 2: SEQUENCE GENERATORS for Auto-Generated IDs
-- ============================================================================

CREATE SEQUENCE IF NOT EXISTS order_number_seq START 1;
CREATE SEQUENCE IF NOT EXISTS receipt_number_seq START 1;
CREATE SEQUENCE IF NOT EXISTS challan_number_seq START 1;
CREATE SEQUENCE IF NOT EXISTS invoice_number_seq START 1;
CREATE SEQUENCE IF NOT EXISTS credit_note_seq START 1;
CREATE SEQUENCE IF NOT EXISTS misprint_sale_seq START 1;

DO $$
BEGIN
  RAISE NOTICE 'Created: 6 sequence generators for unique IDs';
END $$;

-- ============================================================================
-- PART 3: ID GENERATION FUNCTIONS
-- ============================================================================

CREATE OR REPLACE FUNCTION generate_order_number()
RETURNS VARCHAR(50) AS $$
BEGIN
  RETURN 'ORD-' || TO_CHAR(CURRENT_DATE, 'YYYYMMDD') || '-' || LPAD(nextval('order_number_seq')::TEXT, 4, '0');
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION generate_receipt_number()
RETURNS VARCHAR(50) AS $$
BEGIN
  RETURN 'RCP-' || TO_CHAR(CURRENT_DATE, 'YYYYMMDD') || '-' || LPAD(nextval('receipt_number_seq')::TEXT, 4, '0');
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION generate_challan_number()
RETURNS VARCHAR(50) AS $$
BEGIN
  RETURN 'CHN-' || TO_CHAR(CURRENT_DATE, 'YYYYMMDD') || '-' || LPAD(nextval('challan_number_seq')::TEXT, 4, '0');
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION generate_invoice_number()
RETURNS VARCHAR(50) AS $$
BEGIN
  RETURN 'INV-' || TO_CHAR(CURRENT_DATE, 'YYYYMMDD') || '-' || LPAD(nextval('invoice_number_seq')::TEXT, 4, '0');
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION generate_credit_note_number()
RETURNS VARCHAR(50) AS $$
BEGIN
  RETURN 'CN-' || TO_CHAR(CURRENT_DATE, 'YYYYMMDD') || '-' || LPAD(nextval('credit_note_seq')::TEXT, 4, '0');
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION generate_misprint_sale_number()
RETURNS VARCHAR(50) AS $$
BEGIN
  RETURN 'MS-' || TO_CHAR(CURRENT_DATE, 'YYYYMMDD') || '-' || LPAD(nextval('misprint_sale_seq')::TEXT, 4, '0');
END;
$$ LANGUAGE plpgsql;

DO $$
BEGIN
  RAISE NOTICE 'Created: 6 ID generation functions';
END $$;

-- ============================================================================
-- PART 4: UPDATE EXISTING CORE TABLES
-- ============================================================================

-- Update customers table
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name = 'customers' AND column_name = 'is_deleted') THEN
    ALTER TABLE customers ADD COLUMN is_deleted BOOLEAN DEFAULT FALSE;
  END IF;
  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name = 'customers' AND column_name = 'updated_at') THEN
    ALTER TABLE customers ADD COLUMN updated_at TIMESTAMP DEFAULT NOW();
  END IF;
  RAISE NOTICE '[2/13] Updated: customers';
END $$;

-- Update orders table
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name = 'orders' AND column_name = 'ownership_type') THEN
    ALTER TABLE orders ADD COLUMN ownership_type VARCHAR(50) DEFAULT 'customer_material'
      CHECK (ownership_type IN ('customer_material', 'own_stock'));
  END IF;
  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name = 'orders' AND column_name = 'updated_at') THEN
    ALTER TABLE orders ADD COLUMN updated_at TIMESTAMP DEFAULT NOW();
  END IF;
  RAISE NOTICE '[3/13] Updated: orders';
END $$;

-- Make order_number unique and set default
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM information_schema.table_constraints WHERE constraint_name = 'orders_order_number_key') THEN
    ALTER TABLE orders ADD CONSTRAINT orders_order_number_key UNIQUE (order_number);
  END IF;
  IF EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name = 'orders' AND column_name = 'order_number') THEN
    ALTER TABLE orders ALTER COLUMN order_number SET DEFAULT generate_order_number();
  END IF;
END $$;

-- Update material_in table
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name = 'material_in' AND column_name = 'ownership') THEN
    ALTER TABLE material_in ADD COLUMN ownership VARCHAR(20) DEFAULT 'customer'
      CHECK (ownership IN ('customer', 'self'));
  END IF;
  IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name = 'material_in' AND column_name = 'receipt_number') THEN
    ALTER TABLE material_in ADD COLUMN receipt_number VARCHAR(50);
  END IF;
  RAISE NOTICE '[4/13] Updated: material_in';
END $$;

-- Make receipt_number unique and set default
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM information_schema.table_constraints WHERE constraint_name = 'material_in_receipt_number_key') THEN
    ALTER TABLE material_in ADD CONSTRAINT material_in_receipt_number_key UNIQUE (receipt_number);
  END IF;
  IF EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name = 'material_in' AND column_name = 'receipt_number') THEN
    ALTER TABLE material_in ALTER COLUMN receipt_number SET DEFAULT generate_receipt_number();
  END IF;
END $$;

-- ============================================================================
-- PART 5: RECREATE MATERIAL_STOCK TABLE (Core table)
-- ============================================================================

DROP TABLE IF EXISTS material_stock CASCADE;

CREATE TABLE material_stock (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  customer_id UUID REFERENCES customers(id),
  order_id UUID REFERENCES orders(id),
  material_type VARCHAR(50) NOT NULL,
  stage VARCHAR(50) NOT NULL CHECK (stage IN (
    'received', 'preprocessing', 'printing', 'postprocessing',
    'completed', 'misprint', 'damaged', 'sold'
  )),
  quantity INTEGER NOT NULL CHECK (quantity >= 0),
  ownership VARCHAR(20) DEFAULT 'customer' CHECK (ownership IN ('customer', 'self')),
  designs_available BOOLEAN DEFAULT FALSE,
  design_notes TEXT,
  unit_cost DECIMAL(10,2),
  created_at TIMESTAMP DEFAULT NOW(),
  updated_at TIMESTAMP DEFAULT NOW(),
  UNIQUE(customer_id, order_id, material_type, stage, ownership)
);

CREATE INDEX idx_material_stock_customer ON material_stock(customer_id);
CREATE INDEX idx_material_stock_stage ON material_stock(stage) WHERE quantity > 0;
CREATE INDEX idx_material_stock_ownership ON material_stock(ownership);

DO $$
BEGIN
  RAISE NOTICE '[5/13] Created: material_stock (CORE TABLE)';
END $$;

