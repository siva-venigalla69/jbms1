-- 1. CUSTOMERS (Keep as is - already simple)
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_name = 'customers' AND column_name = 'is_deleted'
  ) THEN
    ALTER TABLE customers ADD COLUMN is_deleted BOOLEAN DEFAULT FALSE;
  END IF;

  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_name = 'customers' AND column_name = 'updated_at'
  ) THEN
    ALTER TABLE customers ADD COLUMN updated_at TIMESTAMP DEFAULT NOW();
  END IF;

  RAISE NOTICE '✅ Verified: customers table';
END $$;

-- 2. ORDERS (Add ownership type + auto-generated order_number)
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_name = 'orders' AND column_name = 'ownership_type'
  ) THEN
    ALTER TABLE orders ADD COLUMN ownership_type VARCHAR(50) DEFAULT 'customer_material'
      CHECK (ownership_type IN ('customer_material', 'own_stock'));
  END IF;

  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_name = 'orders' AND column_name = 'updated_at'
  ) THEN
    ALTER TABLE orders ADD COLUMN updated_at TIMESTAMP DEFAULT NOW();
  END IF;

  RAISE NOTICE '✅ Updated: orders table';
END $$;

-- Make order_number unique if not already
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.table_constraints
    WHERE constraint_name = 'orders_order_number_key'
    AND table_name = 'orders'
  ) THEN
    ALTER TABLE orders ADD CONSTRAINT orders_order_number_key UNIQUE (order_number);
  END IF;
END $$;

-- Set default for order_number if column exists and has no default
DO $$
BEGIN
  IF EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_name = 'orders' AND column_name = 'order_number'
  ) THEN
    ALTER TABLE orders ALTER COLUMN order_number SET DEFAULT generate_order_number();
  END IF;
END $$;

-- 3. MATERIAL_IN (Add ownership + unique receipt_number)
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_name = 'material_in' AND column_name = 'ownership'
  ) THEN
    ALTER TABLE material_in ADD COLUMN ownership VARCHAR(20) DEFAULT 'customer'
      CHECK (ownership IN ('customer', 'self'));
  END IF;

  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_name = 'material_in' AND column_name = 'receipt_number'
  ) THEN
    ALTER TABLE material_in ADD COLUMN receipt_number VARCHAR(50);
  END IF;

  RAISE NOTICE '✅ Updated: material_in table';
END $$;

-- Make receipt_number unique
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.table_constraints
    WHERE constraint_name = 'material_in_receipt_number_key'
    AND table_name = 'material_in'
  ) THEN
    ALTER TABLE material_in ADD CONSTRAINT material_in_receipt_number_key UNIQUE (receipt_number);
  END IF;
END $$;

-- Set default for receipt_number
DO $$
BEGIN
  IF EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_name = 'material_in' AND column_name = 'receipt_number'
  ) THEN
    ALTER TABLE material_in ALTER COLUMN receipt_number SET DEFAULT generate_receipt_number();
  END IF;

  RAISE NOTICE '✅ Set default for receipt_number';
END $$;

-- 4. MATERIAL_STOCK (Core - expand for all use cases)
DROP TABLE IF EXISTS material_stock CASCADE;

CREATE TABLE material_stock (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  customer_id UUID REFERENCES customers(id), -- NULL for own stock
  order_id UUID REFERENCES orders(id),
  material_type VARCHAR(50) NOT NULL,
  stage VARCHAR(50) NOT NULL CHECK (stage IN (
    'received',      -- Initial receipt
    'preprocessing', -- Padding/treatment
    'printing',      -- Printing process
    'postprocessing',-- Washing/finishing
    'completed',     -- Ready for delivery
    'misprint',      -- Printing errors
    'damaged',       -- Fabric defects
    'sold'           -- Your stock that was sold
  )),
  quantity INTEGER NOT NULL CHECK (quantity >= 0),
  ownership VARCHAR(20) DEFAULT 'customer' CHECK (ownership IN ('customer', 'self')),
  designs_available BOOLEAN DEFAULT FALSE,
  design_notes TEXT,
  unit_cost DECIMAL(10,2), -- Cost per unit (for own stock)
  created_at TIMESTAMP DEFAULT NOW(),
  updated_at TIMESTAMP DEFAULT NOW(),
  UNIQUE(customer_id, order_id, material_type, stage, ownership)
);

CREATE INDEX idx_material_stock_customer ON material_stock(customer_id);
CREATE INDEX idx_material_stock_stage ON material_stock(stage) WHERE quantity > 0;
CREATE INDEX idx_material_stock_ownership ON material_stock(ownership);
CREATE INDEX idx_material_stock_lookup ON material_stock(customer_id, material_type, stage) WHERE quantity > 0;

COMMENT ON TABLE material_stock IS 'Real-time stock tracking at each stage - supports both job work and own stock';
COMMENT ON COLUMN material_stock.ownership IS 'customer = job work, self = your inventory';
COMMENT ON COLUMN material_stock.stage IS 'Current location/stage of the stock';

DO $$
BEGIN
  RAISE NOTICE '✅ Created: material_stock table (CORE)';
END $$;

-- ============================================================================
-- RETURNS & ADJUSTMENTS
