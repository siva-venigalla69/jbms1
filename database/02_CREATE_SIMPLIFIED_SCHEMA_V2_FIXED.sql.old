-- ============================================================================
-- HELPER FUNCTIONS
-- ============================================================================

-- Function 1: Move stock between stages
CREATE OR REPLACE FUNCTION move_stock_to_stage(
  p_customer_id UUID,
  p_order_id UUID,
  p_material_type VARCHAR,
  p_from_stage VARCHAR,
  p_to_stage VARCHAR,
  p_quantity INTEGER,
  p_ownership VARCHAR DEFAULT 'customer'
)
RETURNS JSONB AS $$
DECLARE
  v_current_qty INTEGER;
  v_result JSONB;
BEGIN
  -- Check if stock exists in from_stage
  SELECT quantity INTO v_current_qty
  FROM material_stock
  WHERE (customer_id = p_customer_id OR (customer_id IS NULL AND p_customer_id IS NULL))
    AND (order_id = p_order_id OR (order_id IS NULL AND p_order_id IS NULL))
    AND material_type = p_material_type
    AND stage = p_from_stage
    AND ownership = p_ownership;

  IF v_current_qty IS NULL OR v_current_qty < p_quantity THEN
    RAISE EXCEPTION 'Insufficient stock in % stage. Available: %, Requested: %',
      p_from_stage, COALESCE(v_current_qty, 0), p_quantity;
  END IF;

  -- Reduce from source stage
  UPDATE material_stock
  SET quantity = quantity - p_quantity,
      updated_at = NOW()
  WHERE (customer_id = p_customer_id OR (customer_id IS NULL AND p_customer_id IS NULL))
    AND (order_id = p_order_id OR (order_id IS NULL AND p_order_id IS NULL))
    AND material_type = p_material_type
    AND stage = p_from_stage
    AND ownership = p_ownership;

  -- Add to destination stage (insert or update)
  INSERT INTO material_stock (
    customer_id, order_id, material_type, stage, quantity, ownership, updated_at
  )
  VALUES (
    p_customer_id, p_order_id, p_material_type, p_to_stage, p_quantity, p_ownership, NOW()
  )
  ON CONFLICT (customer_id, order_id, material_type, stage, ownership)
  DO UPDATE SET
    quantity = material_stock.quantity + p_quantity,
    updated_at = NOW();

  -- Return success
  v_result := jsonb_build_object(
    'success', true,
    'message', format('Moved %s %s from %s to %s', p_quantity, p_material_type, p_from_stage, p_to_stage),
    'quantity_moved', p_quantity,
    'from_stage', p_from_stage,
    'to_stage', p_to_stage
  );

  RETURN v_result;
END;
$$ LANGUAGE plpgsql;

COMMENT ON FUNCTION move_stock_to_stage IS 'Move stock from one stage to another with validation';

DO $$
BEGIN
  RAISE NOTICE '✅ Created: move_stock_to_stage() function';
END $$;

-- Function 2: Update design availability
CREATE OR REPLACE FUNCTION update_design_availability(
  p_customer_id UUID,
  p_order_id UUID,
  p_material_type VARCHAR,
  p_stage VARCHAR,
  p_designs_available BOOLEAN,
  p_design_notes TEXT DEFAULT NULL
)
RETURNS JSONB AS $$
DECLARE
  v_result JSONB;
  v_rows_updated INTEGER;
BEGIN
  UPDATE material_stock
  SET
    designs_available = p_designs_available,
    design_notes = COALESCE(p_design_notes, design_notes),
    updated_at = NOW()
  WHERE (customer_id = p_customer_id OR (customer_id IS NULL AND p_customer_id IS NULL))
    AND (order_id = p_order_id OR (order_id IS NULL AND p_order_id IS NULL))
    AND material_type = p_material_type
    AND stage = p_stage;

  GET DIAGNOSTICS v_rows_updated = ROW_COUNT;

  IF v_rows_updated = 0 THEN
    RAISE EXCEPTION 'Stock not found for customer %, order %, material % in stage %',
      p_customer_id, p_order_id, p_material_type, p_stage;
  END IF;

  v_result := jsonb_build_object(
    'success', true,
    'message', 'Design availability updated',
    'designs_available', p_designs_available
  );

  RETURN v_result;
END;
$$ LANGUAGE plpgsql;

COMMENT ON FUNCTION update_design_availability IS 'Update design availability status for stock';

DO $$
BEGIN
  RAISE NOTICE '✅ Created: update_design_availability() function';
END $$;

-- Function 3: Get customer stock summary
CREATE OR REPLACE FUNCTION get_customer_stock_summary(p_customer_id UUID)
RETURNS TABLE (
  material_type VARCHAR,
  ownership VARCHAR,
  received INTEGER,
  preprocessing INTEGER,
  printing INTEGER,
  postprocessing INTEGER,
  completed INTEGER,
  misprint INTEGER,
  damaged INTEGER,
  total_quantity BIGINT
) AS $$
BEGIN
  RETURN QUERY
  SELECT
    ms.material_type,
    ms.ownership,
    COALESCE(SUM(CASE WHEN ms.stage = 'received' THEN ms.quantity ELSE 0 END), 0)::INTEGER AS received,
    COALESCE(SUM(CASE WHEN ms.stage = 'preprocessing' THEN ms.quantity ELSE 0 END), 0)::INTEGER AS preprocessing,
    COALESCE(SUM(CASE WHEN ms.stage = 'printing' THEN ms.quantity ELSE 0 END), 0)::INTEGER AS printing,
    COALESCE(SUM(CASE WHEN ms.stage = 'postprocessing' THEN ms.quantity ELSE 0 END), 0)::INTEGER AS postprocessing,
    COALESCE(SUM(CASE WHEN ms.stage = 'completed' THEN ms.quantity ELSE 0 END), 0)::INTEGER AS completed,
    COALESCE(SUM(CASE WHEN ms.stage = 'misprint' THEN ms.quantity ELSE 0 END), 0)::INTEGER AS misprint,
    COALESCE(SUM(CASE WHEN ms.stage = 'damaged' THEN ms.quantity ELSE 0 END), 0)::INTEGER AS damaged,
    COALESCE(SUM(ms.quantity), 0) AS total_quantity
  FROM material_stock ms
  WHERE ms.customer_id = p_customer_id
    AND ms.quantity > 0
  GROUP BY ms.material_type, ms.ownership
  ORDER BY ms.material_type, ms.ownership;
END;
$$ LANGUAGE plpgsql;

COMMENT ON FUNCTION get_customer_stock_summary IS 'Get stock summary by stage for a customer';

DO $$
BEGIN
  RAISE NOTICE '✅ Created: get_customer_stock_summary() function';
END $$;

-- ============================================================================
-- REPORTING VIEWS
-- ============================================================================

-- View 1: Stock by Customer
CREATE OR REPLACE VIEW v_stock_by_customer AS
SELECT
  c.id AS customer_id,
  COALESCE(c.name, 'Own Stock') AS customer_name,
  ms.material_type,
  ms.ownership,
  COALESCE(SUM(CASE WHEN ms.stage = 'received' THEN ms.quantity ELSE 0 END), 0) AS received,
  COALESCE(SUM(CASE WHEN ms.stage = 'preprocessing' THEN ms.quantity ELSE 0 END), 0) AS preprocessing,
  COALESCE(SUM(CASE WHEN ms.stage = 'printing' THEN ms.quantity ELSE 0 END), 0) AS printing,
  COALESCE(SUM(CASE WHEN ms.stage = 'postprocessing' THEN ms.quantity ELSE 0 END), 0) AS postprocessing,
  COALESCE(SUM(CASE WHEN ms.stage = 'completed' THEN ms.quantity ELSE 0 END), 0) AS completed,
  COALESCE(SUM(CASE WHEN ms.stage = 'misprint' THEN ms.quantity ELSE 0 END), 0) AS misprint,
  COALESCE(SUM(CASE WHEN ms.stage = 'damaged' THEN ms.quantity ELSE 0 END), 0) AS damaged,
  COALESCE(SUM(ms.quantity), 0) AS total_quantity
FROM material_stock ms
LEFT JOIN customers c ON ms.customer_id = c.id
WHERE ms.quantity > 0
GROUP BY c.id, c.name, ms.material_type, ms.ownership
ORDER BY customer_name, ms.material_type;

DO $$
BEGIN
  RAISE NOTICE '✅ Created: v_stock_by_customer view';
END $$;

-- View 2: Outstanding Payments
CREATE OR REPLACE VIEW v_outstanding_payments AS
SELECT
  c.id AS customer_id,
  c.name AS customer_name,
  COALESCE(SUM(inv.total_amount), 0) AS total_invoiced,
  COALESCE(SUM(p.amount), 0) AS total_paid,
  COALESCE(SUM(inv.total_amount), 0) - COALESCE(SUM(p.amount), 0) AS outstanding_amount,
  COUNT(DISTINCT inv.id) AS invoice_count
FROM customers c
LEFT JOIN gst_invoices inv ON c.id = inv.customer_id AND COALESCE(inv.is_deleted, FALSE) = FALSE
LEFT JOIN payments p ON inv.id = p.invoice_id
GROUP BY c.id, c.name
HAVING COALESCE(SUM(inv.total_amount), 0) - COALESCE(SUM(p.amount), 0) > 0
ORDER BY outstanding_amount DESC;

DO $$
BEGIN
  RAISE NOTICE '✅ Created: v_outstanding_payments view';
END $$;

-- View 3: Outstanding Orders (Pending Deliveries)
CREATE OR REPLACE VIEW v_outstanding_orders AS
SELECT
  c.id AS customer_id,
  c.name AS customer_name,
  o.id AS order_id,
  o.order_number,
  ms.material_type,
  o.total_quantity,
  COALESCE(SUM(ci.quantity), 0) AS delivered_quantity,
  o.total_quantity - COALESCE(SUM(ci.quantity), 0) AS pending_quantity
FROM orders o
JOIN customers c ON o.customer_id = c.id
LEFT JOIN material_stock ms ON o.id = ms.order_id
LEFT JOIN delivery_challans dc ON o.id = dc.order_id AND COALESCE(dc.is_deleted, FALSE) = FALSE
LEFT JOIN challan_items ci ON dc.id = ci.challan_id AND ci.material_type = ms.material_type
WHERE o.status != 'completed'
GROUP BY c.id, c.name, o.id, o.order_number, o.total_quantity, ms.material_type
HAVING o.total_quantity - COALESCE(SUM(ci.quantity), 0) > 0
ORDER BY c.name, o.order_number;

DO $$
BEGIN
  RAISE NOTICE '✅ Created: v_outstanding_orders view';
END $$;

-- View 4: Misprint Stock (Available for Sale)
CREATE OR REPLACE VIEW v_misprint_stock AS
SELECT
  material_type,
  ownership,
  SUM(quantity) AS total_quantity,
  COALESCE(c.name, 'Own Stock') AS source
FROM material_stock ms
LEFT JOIN customers c ON ms.customer_id = c.id
WHERE ms.stage = 'misprint'
  AND ms.quantity > 0
GROUP BY material_type, ownership, c.name
ORDER BY material_type;

DO $$
BEGIN
  RAISE NOTICE '✅ Created: v_misprint_stock view';
END $$;

-- ============================================================================
-- VERIFICATION & COMPLETION
-- ============================================================================

DO $$
DECLARE
  table_count INTEGER;
  function_count INTEGER;
  view_count INTEGER;
BEGIN
  -- Count tables
  SELECT COUNT(*) INTO table_count
  FROM information_schema.tables
  WHERE table_schema = 'public'
    AND table_name IN (
      'customers', 'orders', 'material_in', 'material_stock',
      'returns', 'credit_notes', 'misprint_sales',
      'delivery_challans', 'challan_items',
      'gst_invoices', 'payments', 'invoice_challans', 'material_types'
    );

  -- Count functions
  SELECT COUNT(*) INTO function_count
  FROM information_schema.routines
  WHERE routine_schema = 'public'
    AND routine_name IN (
      'move_stock_to_stage',
      'update_design_availability',
      'get_customer_stock_summary',
      'generate_order_number',
      'generate_receipt_number',
      'generate_challan_number',
      'generate_invoice_number',
      'generate_credit_note_number',
      'generate_misprint_sale_number'
    );

  -- Count views
  SELECT COUNT(*) INTO view_count
  FROM information_schema.views
  WHERE table_schema = 'public'
    AND table_name LIKE 'v_%';

  RAISE NOTICE '';
  RAISE NOTICE '========================================================================';
  RAISE NOTICE '✅ SIMPLIFIED SCHEMA V2 COMPLETE!';
  RAISE NOTICE '========================================================================';
  RAISE NOTICE '';
  RAISE NOTICE '📊 SUMMARY:';
  RAISE NOTICE '   • Core Tables: % (including material_types & invoice_challans)', table_count;
  RAISE NOTICE '   • Helper Functions: %', function_count;
  RAISE NOTICE '   • Reporting Views: %', view_count;
  RAISE NOTICE '';
  RAISE NOTICE '✅ NEW FEATURES:';
  RAISE NOTICE '   • Auto-generated unique IDs for orders, receipts, challans, invoices';
  RAISE NOTICE '   • Product types table (Sarees, Dupattas, Voni, Lehenga, Running Material)';
  RAISE NOTICE '   • Invoice-Challan linking (create invoices from delivery challans)';
  RAISE NOTICE '   • Sequences for consistent numbering (ORD-20251220-0001, etc.)';
  RAISE NOTICE '';
  RAISE NOTICE '🎯 UNIQUE ID FORMATS:';
  RAISE NOTICE '   • Orders:      ORD-YYYYMMDD-0001';
  RAISE NOTICE '   • Receipts:    RCP-YYYYMMDD-0001';
  RAISE NOTICE '   • Challans:    CHN-YYYYMMDD-0001';
  RAISE NOTICE '   • Invoices:    INV-YYYYMMDD-0001';
  RAISE NOTICE '   • Credit Notes: CN-YYYYMMDD-0001';
  RAISE NOTICE '   • Misprint Sales: MS-YYYYMMDD-0001';
  RAISE NOTICE '';
  RAISE NOTICE '========================================================================';
  RAISE NOTICE '';
END $$;
