-- ============================================================================
-- STEP 1: BACKUP ALL EXISTING TABLES
-- ============================================================================
-- Execute this in Supabase SQL Editor BEFORE any changes
-- This creates backup copies of all tables with data
-- ============================================================================

-- Create schema for backups
CREATE SCHEMA IF NOT EXISTS backup_schema;

-- Set search path
SET search_path TO public, backup_schema;

DO $$
BEGIN
  RAISE NOTICE '';
  RAISE NOTICE '========================================================================';
  RAISE NOTICE '🔄 STARTING COMPLETE DATABASE BACKUP';
  RAISE NOTICE '========================================================================';
  RAISE NOTICE '';
END $$;

-- ============================================================================
-- BACKUP: Design Management Tables (12 tables)
-- ============================================================================

DO $$ BEGIN
  IF EXISTS (SELECT FROM information_schema.tables WHERE table_name = 'design_submissions') THEN
    EXECUTE 'CREATE TABLE backup_schema.design_submissions AS SELECT * FROM public.design_submissions';
    RAISE NOTICE '✅ Backed up: design_submissions';
  END IF;
END $$;

