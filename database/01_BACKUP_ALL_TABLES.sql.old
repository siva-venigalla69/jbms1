-- ============================================================================
-- VERIFICATION
-- ============================================================================

DO $$
DECLARE
  backup_count INTEGER;
  original_count INTEGER;
BEGIN
  -- Count tables in backup schema
  SELECT COUNT(*) INTO backup_count
  FROM information_schema.tables
  WHERE table_schema = 'backup_schema';

  -- Count tables in public schema
  SELECT COUNT(*) INTO original_count
  FROM information_schema.tables
  WHERE table_schema = 'public';

  RAISE NOTICE '';
  RAISE NOTICE '========================================================================';
  RAISE NOTICE '✅ BACKUP COMPLETE!';
  RAISE NOTICE '========================================================================';
  RAISE NOTICE '';
  RAISE NOTICE '📊 BACKUP SUMMARY:';
  RAISE NOTICE '   • Tables backed up: %', backup_count;
  RAISE NOTICE '   • Original tables: %', original_count;
  RAISE NOTICE '   • Backup location: backup_schema';
  RAISE NOTICE '';
  RAISE NOTICE '⚠️  IMPORTANT:';
  RAISE NOTICE '   • Backups are in backup_schema';
  RAISE NOTICE '   • To restore: COPY from backup_schema to public';
  RAISE NOTICE '   • Keep backups until migration is verified';
  RAISE NOTICE '';
  RAISE NOTICE '========================================================================';
  RAISE NOTICE '';
END $$;

-- List all backed up tables
SELECT
  table_name,
  (SELECT COUNT(*) FROM backup_schema.|| table_name ||) AS row_count
FROM information_schema.tables
WHERE table_schema = 'backup_schema'
ORDER BY table_name;
